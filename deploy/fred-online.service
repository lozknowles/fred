[Unit]
Description=Fred ten-player room server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/fred
Environment=NODE_ENV=production
EnvironmentFile=%h/.config/elsemesh/online.env
ExecStart=/usr/bin/node tools/networking/online-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
